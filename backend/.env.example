# Copy to .env for local (non-Docker) development. Docker Compose injects
# its own values for DATABASE_URL/REDIS_URL/STORAGE_BACKEND/MINIO_ENDPOINT
# (see docker-compose.yml `environment:` blocks) — this file is only read
# when running the backend directly against `venv`.

ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://annotate:annotate@localhost:5432/annotate
REDIS_URL=redis://localhost:6379/0

# local = filesystem under ../storage/local, no MinIO needed for dev
STORAGE_BACKEND=local

MAX_UPLOAD_SIZE_MB=200

# Optional. Leave unset to run with Kaggle training disabled — the app is
# fully functional with LOCAL training only (see PLAN "Training providers").
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Optional. Leave unset to run with Modal training disabled — the app is
# fully functional with LOCAL/KAGGLE training only.
# Get your credentials from https://modal.com/settings → API Tokens
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
